<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs Unity 2019.4 / Mono: target .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>KRILL</AssemblyName>
    <RootNamespace>KRILL</RootNamespace>
    <Version>0.3.1</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- KSP install the reference assemblies come from. Defaults to the game
         root three levels up (the repo living in <KSP>/GameData/KRILL); when the
         repo lives elsewhere, pass it explicitly (2026-09-18):
             dotnet build -c Release -p:KspRoot="E:\path\to\KSP" -->
    <KspRoot Condition="'$(KspRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..</KspRoot>
  </PropertyGroup>

  <!-- Console (flight button grid) is work in progress and NOT part of a release
       build (2026-09-02). A plain `dotnet build` leaves it out entirely: the
       KSPAddon and the toolbar right-click that shows it are both compiled only
       when KRILL_CONSOLE_PREVIEW is defined. To work on it locally:
           dotnet build -c Release -p:KrillConsolePreview=true
       and copy the placeholder textures from dev/console_templates/ into
       GameData/KRILL/Textures/Console/Apollo/ (see CLAUDE.md). -->
  <PropertyGroup Condition="'$(KrillConsolePreview)' == 'true'">
    <DefineConstants>$(DefineConstants);KRILL_CONSOLE_PREVIEW</DefineConstants>
  </PropertyGroup>

  <!-- In-game data self-tests (KrillSelfTest.cs: ConfigNode round-trips that
       need KSP's own ConfigNode, so they can't run outside the game). Compiled
       only when KRILL_SELFTEST is defined; a release build has no trace of them.
           dotnet build -c Release -p:KrillSelfTest=true
       Results go to KSP.log as [KRILL][selftest] lines at main menu (2026-09-07). -->
  <PropertyGroup Condition="'$(KrillSelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);KRILL_SELFTEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against reference assemblies even without a local targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ToolbarControl">
      <HintPath>$(KspRoot)\GameData\001_ToolbarControl\Plugins\ToolbarControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the plugin DLL into the mod folder KSP actually loads.
       2026-07-26: the install/publish payload now lives one level deeper,
       under GameData/KRILL/ (mirrors the GitHub repo's own GameData/KRILL/
       layout) rather than directly here — see CLAUDE.md folder layout. -->
  <Target Name="DeployToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\GameData\KRILL\Plugins\" />
  </Target>

</Project>
